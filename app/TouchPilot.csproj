<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>TouchPilot</AssemblyName><RootNamespace>TouchPilot</RootNamespace>
    <Product>TouchPilot</Product><Title>TouchPilot</Title><Description>Independent touch, pen and mouse control</Description>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType><ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
</Project>
